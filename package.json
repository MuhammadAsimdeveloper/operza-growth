{
  "name": "operza",
  "version": "1.0.0",
  "private": true,
  "description": "Operza — The Open-Source Unified Business OS, Multi-Tenant Agency CRM & Intelligent Workflow Orchestrator",
  "type": "module",
  "homepage": "https://github.com/MuhammadAsimdeveloper/operza-growth#readme",
  "bugs": {
    "url": "https://github.com/MuhammadAsimdeveloper/operza-growth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuhammadAsimdeveloper/operza-growth.git"
  },
  "license": "MIT",
  "author": "Operza Contributors",
  "keywords": [
    "crm",
    "agency-crm",
    "business-operating-system",
    "workflow-orchestrator",
    "workflow-automation",
    "visual-builder",
    "funnel-builder",
    "ai-copilot",
    "row-level-security",
    "multi-tenant",
    "typescript",
    "react-19",
    "redis-queue"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --workspace=@operza/api run dev",
    "dev:web": "npm --workspace=@operza/web run dev",
    "worker": "npm --workspace=@operza/api run worker",
    "build": "npm --workspace=@operza/web run build",
    "typecheck": "npm --workspace=@operza/web run typecheck",
    "db:setup": "node scripts/setup-db.mjs",
    "db:migrate": "npm --workspace=@operza/db run db:migrate",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "test": "npm --workspace=@operza/workflow-engine test && node scripts/seo-audit/run-seo-checks.mjs && node scripts/test-auth-and-db.mjs && node scripts/test-forms-and-migrations.mjs && node scripts/test-security-and-payments.mjs && node scripts/test-e2e.mjs && node scripts/test-copilot-enterprise.mjs",
    "test:forms": "node scripts/test-forms-and-migrations.mjs",
    "test:security": "node scripts/test-security-and-payments.mjs",
    "test:auth": "node scripts/test-auth-and-db.mjs",
    "test:unit": "npm --workspace=@operza/workflow-engine test",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:seo": "node scripts/seo-audit/run-seo-checks.mjs",
    "test:copilot": "node scripts/test-copilot-enterprise.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
