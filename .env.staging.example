# ==============================================================================
# Operza Enterprise Platform — Staging Environment Configuration Template
# ==============================================================================
# Copy this file to .env.staging and populate with isolated staging credentials.
# In staging mode (NODE_ENV=staging), the application FAILS CLOSED if PostgreSQL
# is unreachable or unconfigured. Local JSON file mode (store.json) is prohibited.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=staging
PORT=4000
HOST=0.0.0.0
WEB_PORT=5173
PUBLIC_BASE_URL=https://staging-api.operza.internal
ALLOWED_ORIGINS=https://staging.operza.internal,https://staging-api.operza.internal

# Cryptographic Session & CSRF Secrets (Generate with: openssl rand -hex 32)
# REQUIRED: Must be at least 32 characters long.
SESSION_SECRET=replace_with_a_secure_random_hex_string_32_characters_minimum
OPERZA_VAULT_KEY=replace_with_a_64_char_hex_key_for_aes_256_gcm_storage_000000000
OPERZA_ADMIN_KEY=replace_with_secure_random_admin_key_for_internal_telemetry
ENCRYPTION_MASTER_KEY=replace_with_a_64_char_hex_key_for_aes_256_gcm_storage_000000000

# ------------------------------------------------------------------------------
# 2. Relational PostgreSQL & Row-Level Security (RLS) Configuration
# ------------------------------------------------------------------------------
# Staging database host (AWS RDS Aurora PostgreSQL 16 or isolated PostgreSQL container)
POSTGRES_HOST=staging-db.operza.internal
POSTGRES_PORT=5432
POSTGRES_DB=operza_staging

# Unprivileged runtime application connection (Strictly enforces PostgreSQL RLS)
# Role: operza_app (NOBYPASSRLS, NOSUPERUSER)
DATABASE_URL=postgresql://operza_app:staging_app_secure_password@staging-db.operza.internal:5432/operza_staging
DATABASE_SSL=true

# Privileged migration connection (Used exclusively by CI/CD db:migrate job)
# Role: operza_migrator (Owner of tables and schema migrations)
MIGRATION_DATABASE_URL=postgresql://operza_migrator:staging_migrator_secure_password@staging-db.operza.internal:5432/operza_staging

# Dedicated background worker role (Access to workflow_outbox and leases)
# Role: operza_worker
WORKER_DATABASE_URL=postgresql://operza_worker:staging_worker_secure_password@staging-db.operza.internal:5432/operza_staging

# Connection Pool Limits
PG_MAX_POOL=25
PG_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. Distributed Redis Queue & Durable Background Worker
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:staging_redis_token@staging-redis.operza.internal:6379
# In staging, in-memory queue fallback must be disabled to verify real Redis
ALLOW_IN_MEMORY_QUEUE=false
WORKER_ID=operza-staging-worker-1
WORKER_CONCURRENCY=10
WORKER_LEASE_MS=30000

# ------------------------------------------------------------------------------
# 4. Third-Party Provider Sandboxes (Test / Sandbox Keys Only)
# ------------------------------------------------------------------------------
# Stripe Payments Sandbox (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_51MockOperzaStripeKeyForStagingEnvironmentOnly00000000
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret_staging_1234567890

# Twilio Telephony & SMS Sandbox (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACmockstagingtwiliosid0000000000000000
TWILIO_AUTH_TOKEN=mock_staging_twilio_auth_token_32chars
TWILIO_PHONE_NUMBER=+15005550006
TWILIO_API_KEY_SID=SKmockstagingwebrtcvoicekey000000000000
TWILIO_API_KEY_SECRET=mockstagingwebrtcvoicesecret32chars

# Resend / SendGrid Email Sandbox
RESEND_API_KEY=re_mock_staging_resend_api_key_for_testing
SENDGRID_API_KEY=SG.mock_staging_sendgrid_key_00000000000000000000000000000000000
FROM_EMAIL=notifications@staging.operza.internal

# Meta WhatsApp Cloud API Sandbox
WHATSAPP_PHONE_NUMBER_ID=mock_staging_wa_phone_id_12345
WHATSAPP_ACCESS_TOKEN=EAAMockStagingWhatsAppTokenForIntegrationTesting00000000

# Microsoft Outlook & Graph Mailbox OAuth (https://portal.azure.com)
MICROSOFT_CLIENT_ID=mock_staging_microsoft_client_id_00000000
MICROSOFT_CLIENT_SECRET=mock_staging_microsoft_client_secret_000000
MICROSOFT_REDIRECT_URI=https://staging-api.operza.internal/api/platform/oauth/outlook/callback

# Zapier REST Hook Platform Integration
ZAPIER_CLIENT_ID=operza-staging-zapier-client
ZAPIER_CLIENT_SECRET=operza-staging-zapier-secret-32chars

# ------------------------------------------------------------------------------
# 5. AI Workforce Model Endpoints (Sandboxed Staging Keys)
# ------------------------------------------------------------------------------
# Primary Cloud Model Provider
ANTHROPIC_API_KEY=sk-ant-mock-staging-key-for-copilot-testing-00000000000000000
OPENAI_API_KEY=sk-mock-staging-openai-key-for-copilot-testing-000000000000000000
DEEPSEEK_API_KEY=sk-mock-staging-deepseek-key-000000000000000000000000000000000

# Local AI Cascade / Self-Hosted Inference (Optional)
OLLAMA_BASE_URL=http://staging-ollama.operza.internal:11434

# ------------------------------------------------------------------------------
# 6. Platform Administrator Credentials (Seed Tenant & Control Plane)
# ------------------------------------------------------------------------------
OPERZA_ADMIN_EMAIL=admin@staging.operza.internal
OPERZA_ADMIN_PASSWORD=OperzaStagingAdmin2026!Secure

# Rate Limiting & SSRF Security Controls
RATE_LIMIT_MAX_REQUESTS=1000
SSRF_ALLOWED_WEBHOOK_DOMAINS=hooks.zapier.com,staging-webhooks.operza.internal
