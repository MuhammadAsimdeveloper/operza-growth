# ==============================================================================
# Operza Unified Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the repository root or configure in your deployment.
# All variables have sensible defaults for zero-friction local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_PORT=5173
PUBLIC_BASE_URL=http://localhost:4000
SESSION_SECRET=operza-super-secret-production-grade-session-key-change-me-in-production-min-32-chars

# ------------------------------------------------------------------------------
# 2. PERSISTENCE LAYER (PostgreSQL Multi-Tenant Row-Level Security)
# ------------------------------------------------------------------------------
# If DATABASE_URL is not set or PostgreSQL is unreachable, Operza automatically
# boots into zero-config JSON file store mode (data/store.json).
#
# Production PostgreSQL connection string (unprivileged app role with RLS):
DATABASE_URL=postgresql://operza_app:operza_app_secret@localhost:5432/operza_db
POSTGRES_APP_PASSWORD=operza_app_secret

# Migrator connection string (privileged role for schema migrations only):
MIGRATION_DATABASE_URL=postgresql://operza_migrator:operza_migrator_secret@localhost:5432/operza_db
POSTGRES_MIGRATOR_PASSWORD=operza_migrator_secret

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED QUEUE & LOCKS (Redis BullMQ)
# ------------------------------------------------------------------------------
# If REDIS_URL is omitted, Operza uses a high-precision, in-memory durable queue.
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3A. NORMALIZED PLATFORM DATA & DURABLE OUTBOX
# ------------------------------------------------------------------------------
# Apply migrations 008 and 009 before enabling normalized platform persistence.
# If false, provider connections, consent, Copilot proposals and usage use the
# existing JSON application-state fallback. No automatic migration is performed.
PLATFORM_DB_ENABLED=false

# Separate worker identity. Authenticates as the provisioned operza_worker role. Never reuse DATABASE_URL.
WORKER_DATABASE_URL=postgresql://operza_worker:operza_worker_secret@localhost:5432/operza_db
POSTGRES_WORKER_PASSWORD=operza_worker_secret
WORKER_ID=operza-worker-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_LEASE_MS=30000
WORKER_CONCURRENCY=4
WORKER_DB_POOL_MAX=4

# A trusted local module exporting { handlers: { 'event.type': async (...) => ... } }.
# No built-in external provider handlers ship with this phase.
WORKFLOW_JOB_MODULE=

# ------------------------------------------------------------------------------
# 4. EXTERNAL WORKFLOW ORCHESTRATION & WEBHOOKS
# ------------------------------------------------------------------------------
# Optional external webhook dispatcher endpoint
EXTERNAL_WORKFLOW_URL=
EXTERNAL_WORKFLOW_API_KEY=

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE & COPILOT RUNTIME
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
# Local model providers (Ollama / LocalAI) for air-gapped / private on-premise execution
OLLAMA_BASE_URL=http://localhost:11434
LOCALAI_BASE_URL=http://localhost:8080/v1

# ------------------------------------------------------------------------------
# 6. OMNICHANNEL TELEPHONY & MESSAGING (Twilio & WebRTC Softphone)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WebRTC ICE STUN/TURN servers (JSON array format, fallback: Google Public STUN)
# WEBRTC_ICE_SERVERS='[{"urls":["stun:stun.l.google.com:19302"]}]'

# ------------------------------------------------------------------------------
# 7. PAYMENT PROCESSING (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. TRANSACTIONAL EMAIL & WHATSAPP CLOUD API
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_KEY=
RESEND_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=notifications@operza.io

# ------------------------------------------------------------------------------
# 9. 2-WAY CALENDAR INTEGRATION (Google Calendar & Outlook / Microsoft 365)
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 10. ZAPIER PLATFORM INTEGRATION SUITE (5,000+ External Connectors)
# ------------------------------------------------------------------------------
ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=
# Optional global webhook signing secret for HMAC-SHA256 verification
ZAPIER_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 11. PRODUCTION RATE LIMITING & SECURITY GUARDS
# ------------------------------------------------------------------------------
# Default per-IP per-minute rate limits (development: relaxed, production: strict)
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX=10
