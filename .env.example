# ==============================================================================
# Operza Unified Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the repository root or configure in your deployment.
# All variables have sensible defaults for zero-friction local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_PORT=5173
PUBLIC_BASE_URL=http://localhost:4000
SESSION_SECRET=operza-super-secret-production-grade-session-key-change-me-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4000,https://operza.io,https://www.operza.io

# ------------------------------------------------------------------------------
# 2. PERSISTENCE LAYER (PostgreSQL Multi-Tenant Row-Level Security)
# ------------------------------------------------------------------------------
# If DATABASE_URL is not set or PostgreSQL is unreachable, Operza automatically
# boots into zero-config JSON file store mode (data/store.json).
#
# Production PostgreSQL connection string (unprivileged app role with RLS):
DATABASE_URL=postgresql://operza_app:operza_secret@localhost:5432/operza_db

# Migrator connection string (privileged role for schema migrations only):
MIGRATION_DATABASE_URL=postgresql://operza_migrator:operza_migrator_secret@localhost:5432/operza_db

# ------------------------------------------------------------------------------
# 3. DURABLE REDIS QUEUE & DEAD-LETTER QUEUE (DLQ)
# ------------------------------------------------------------------------------
# In production, Redis is required for atomic job leasing and cross-worker deduplication.
REDIS_URL=redis://localhost:6379
ALLOW_IN_MEMORY_QUEUE=false

# ------------------------------------------------------------------------------
# 4. EXTERNAL WORKFLOW ORCHESTRATION & WEBHOOKS
# ------------------------------------------------------------------------------
# Optional external webhook dispatcher endpoint
EXTERNAL_WORKFLOW_URL=
EXTERNAL_WORKFLOW_API_KEY=

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE & COPILOT RUNTIME
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 6. OMNICHANNEL TELEPHONY & MESSAGING (Twilio, WhatsApp, Meta)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Meta & WhatsApp Cloud API Handshake Secrets
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
META_VERIFY_TOKEN=
META_APP_SECRET=

# ------------------------------------------------------------------------------
# 7. PAYMENT PROCESSING (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. TRANSACTIONAL EMAIL (SendGrid / SMTP)
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=notifications@operza.io
