# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_PORT=5173

# Security & Sessions
SESSION_SECRET=operza-production-grade-session-secret-change-this-in-real-deployment-32chars
PUBLIC_BASE_URL=http://localhost:4000

# PostgreSQL Configuration (Multi-Tenant with Row-Level Security)
# For local dev without Postgres, the app falls back to local JSON store automatically.
DATABASE_URL=postgresql://operza_app:operza_secret@localhost:5432/operza_db
MIGRATION_DATABASE_URL=postgresql://operza_migrator:operza_migrator_secret@localhost:5432/operza_db

# Redis Configuration (Distributed Queues & Locks)
REDIS_URL=redis://localhost:6379

# n8n Automation Engine Bridge
N8N_URL=http://localhost:5678
N8N_API_KEY=

# LLM & AI Copilot Runtime
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External Omnichannel Webhook & Provider Credentials (Optional for Dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
