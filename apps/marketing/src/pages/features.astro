---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Features — Operza Growth"
  description="Explore Operza Growth CRM, Workflow Automation V2, Calendar V2, Sites & Funnels V2, and governed AI capabilities."
  canonicalPath="/features"
>
  <h1>Platform Features</h1>
  <div class="grid">
    <article class="card">
      <h2>Funnels &amp; Sites V2</h2>
      <p>Draft and published version isolation, rollback history, server-rendered HTML, and per-domain SEO metadata.</p>
    </article>
    <article class="card">
      <h2>Calendar V2 Scheduling</h2>
      <p>Timezone-aware availability windows, buffers, minimum notice, time-off blocks, and PostgreSQL overlap prevention.</p>
    </article>
    <article class="card">
      <h2>Governed AI Infrastructure</h2>
      <p>Tenant-isolated RAG retrieval, risk-classified tool registry, human approval gates, and monthly cost budgets.</p>
    </article>
  </div>
</MarketingLayout>
