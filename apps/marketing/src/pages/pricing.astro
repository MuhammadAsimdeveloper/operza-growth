---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Pricing — Operza Growth"
  description="Transparent agency plans for Operza Growth CRM, Automation, Sites, and AI governance."
  canonicalPath="/pricing"
>
  <h1>Plans &amp; Entitlements</h1>
  <div class="grid">
    <article class="card">
      <h2>Starter</h2>
      <p>Core CRM, pipelines, forms, tasks, and basic scheduling for small teams.</p>
    </article>
    <article class="card">
      <h2>Growth</h2>
      <p>Workflow Automation V2, Funnels &amp; Sites V2, custom domains, and AI Copilot governance.</p>
    </article>
    <article class="card">
      <h2>Agency Scale</h2>
      <p>Multi-location sub-accounts, custom domain SSL, Integration Hub SDK, and dedicated AI budget controls.</p>
    </article>
  </div>
</MarketingLayout>
