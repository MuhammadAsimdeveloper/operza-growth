---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Operza Growth — Multi-Tenant Agency CRM & Automation Platform"
  description="Unified multi-tenant CRM, durable workflow automation, scheduling, funnels, and governed AI infrastructure for agencies."
  canonicalPath="/"
>
  <section style="padding: 2rem 0;">
    <h1>Multi-Tenant CRM, Durable Workflows &amp; Governed AI</h1>
    <p>
      Operza Growth unifies contacts, pipelines, scheduling, funnels, omnichannel conversations,
      and bounded AI agents on a PostgreSQL Row-Level Security foundation.
    </p>
  </section>

  <section class="grid" aria-label="Core Platform Capabilities">
    <article class="card">
      <h2>Tenant-Isolated CRM &amp; Pipelines</h2>
      <p>Contacts, opportunities, tasks, forms, and reviews backed by TenantTx and PostgreSQL FORCE RLS.</p>
    </article>
    <article class="card">
      <h2>Durable Workflow Engine V2</h2>
      <p>Visual @xyflow/react builder, optimistic versioning, durable leases, and approval-gated actions.</p>
    </article>
    <article class="card">
      <h2>Sites, Funnels &amp; Calendar V2</h2>
      <p>Versioned page publishing, DNS-verified custom domains, and GiST-enforced appointment scheduling.</p>
    </article>
  </section>
</MarketingLayout>
